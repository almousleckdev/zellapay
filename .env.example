# Local development environment for ZellaPay. Copy to .env.local and fill in.
# Never commit real values. Secrets are base64 and decode to at least 32 bytes:
#   openssl rand -base64 32
ZP_ENV=local

# PostgreSQL and Redis from `make up` (non-default ports on purpose).
ZP_DATABASE_URL=postgres://zellapay:zellapay-local-only@127.0.0.1:5433/zellapay?sslmode=disable
ZP_MIGRATE_DATABASE_URL=postgres://zellapay:zellapay-local-only@127.0.0.1:5433/zellapay?sslmode=disable
ZP_REDIS_URL=redis://127.0.0.1:6380/0

# Encryption of customer data at rest. Use different values for each key.
ZP_DATA_KEY_ID=k1
ZP_DATA_KEY=
ZP_BLIND_INDEX_KEY=

# Mixed into every password before hashing; never stored in the database.
# Losing it locks every user out, so keep it in the secret manager. To rotate,
# add a new version and keep the old one until users have signed in again.
ZP_PASSWORD_PEPPER=
ZP_PASSWORD_PEPPER_VERSION=1

# Where emailed links point (invitations, verification, password reset).
ZP_DASHBOARD_URL=http://localhost:3001

# Where staff reach the admin console. Passkeys are bound to this address and
# its domain, so they must match what staff really type. Production needs https.
ZP_ADMIN_URL=http://localhost:3002
ZP_WEBAUTHN_RP_ID=localhost

# Networks whose X-Forwarded-For header is believed (comma-separated CIDR
# ranges): your load balancer and the dashboard servers. Outside production
# this defaults to loopback; in production it defaults to none, so the API
# sees the proxy's address for everyone until you list it. Never trust 0.0.0.0/0.
# ZP_TRUSTED_PROXIES=10.0.0.0/8

# The operator simulator. Never enabled in production.
ZP_SIMULATOR_SECRET=

# Webhook destinations. Outside production, local receivers are allowed by
# default. Production never allows private addresses.
ZP_WEBHOOKS_ALLOW_PRIVATE=true

# How long collected funds wait before they can be paid out, and the largest
# single payout in the smallest currency unit.
# Set the delay to e.g. 10s to try payouts locally.
ZP_SETTLEMENT_DELAY=24h
ZP_PAYOUT_MAX_AMOUNT=5000000

# Email. In development the defaults send everything to MailDev (docker
# compose, inbox at http://localhost:1081). Production must set a real server
# and always uses TLS.
ZP_SMTP_ADDR=127.0.0.1:1026
# ZP_MAIL_FROM=ZellaPay <no-reply@zellapay.test>

# The staff account `make up` creates for local development, so the admin
# console can be signed in to at once. It is created only when ZP_ENV=local.
# `make env` generates the password; read it here. Never use it elsewhere.
ZP_DEV_STAFF_EMAIL=admin@zellapay.test
ZP_DEV_STAFF_NAME=DevAdmin
ZP_DEV_STAFF_PASSWORD=
